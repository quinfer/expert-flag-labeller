# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Google Street View Images (licensed content - DO NOT COMMIT)
# These directories contain images derived from Google Street View 
# which are under license restrictions and should not be shared publicly
/public/images/
/public/static/
/public/FlagExamples/
/data/true_positive_images/
/data/true_positive_masked_images/
/data/cropped_images_for_classification/

# Large data files
/data/classification_queue.json
/data/classifications/

# Private academic research materials - SELECTIVE INCLUSION
# Include documentation but exclude large model files and experiments
/MSc-Themed-Research-Project/flag_classification_adaptation/experiments/
/MSc-Themed-Research-Project/flag_classification_adaptation/output/
/MSc-Themed-Research-Project/final_code/checkpoints/
/MSc-Themed-Research-Project/data/ni_flags*/images/
/MSc-Themed-Research-Project/data/processed/
/MSc-Themed-Research-Project/archive/
/MSc-Themed-Research-Project/qub-gitlab-submission/data/

# Exclude specific large files
*.pt
*.pth
*.pth.tar*
**/model*.pth*
**/best_model*
**/checkpoints/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
